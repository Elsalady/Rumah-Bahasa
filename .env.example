APP_NAME="Rumah Bahasa Surabaya"
# Production: APP_ENV=production, APP_DEBUG=false
# Development: APP_ENV=local, APP_DEBUG=true
APP_ENV=production
APP_KEY=
# Wajib diisi domain asli pas deploy — semua link (redirect, email, sitemap) pakai ini
APP_URL=https://rumahbahasa.surabaya.go.id
# JANGAN true di production — bakal bocorin stack trace & info sensitif
APP_DEBUG=false

# Password admin default saat db:seed — WAJIB diganti dengan password kuat di production!
# Kalau dikosongkan, seeder bikin password acak.
ADMIN_PASSWORD=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== DATABASE (PostgreSQL — sesuaikan dengan server) =====
# Buat database dulu di PostgreSQL:
#   CREATE DATABASE rumah_bahasa;
#   CREATE USER rumah_bahasa_user WITH PASSWORD 'password123';
#   GRANT ALL PRIVILEGES ON DATABASE rumah_bahasa TO rumah_bahasa_user;
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rumah_bahasa
DB_USERNAME=rumah_bahasa_user
DB_PASSWORD=password123

# ===== SESSION (file = gak perlu database buat session) =====
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ===== QUEUE + CACHE (gak perlu database buat development) =====
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ===== MAIL (opsional) =====
# Dipakai untuk notifikasi "ada pesan baru" dari form kontak ke email admin.
# Kalau nggak diset, notifikasi tetap masuk ke panel admin — email cuma pelengkap.
# Development lokal: cukup MAIL_MAILER=log (email ditulis ke storage/logs/laravel.log)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@rumahbahasa.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
